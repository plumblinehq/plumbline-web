# Base URL of the Plumbline server API.
#
# Everything the directory renders comes from here; the app computes nothing
# itself. The value is baked into the bundle at build time, so it must be set
# on the host before the build runs, not at runtime.
#
# Local development reads the deployed API by default. Point it at a local
# server with VITE_API_BASE=http://localhost:3000 if you are running one.
VITE_API_BASE=https://plumbline-server.onrender.com
